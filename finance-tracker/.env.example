# ---------------------------------------------------------------------------
# finance-tracker configuration
#
# Copy to `.env` and fill in. Nothing here is required to run the mock
# provider, which is the default — you can develop and test the entire
# system with no Plaid account at all:
#
#     npm run cli -- demo
#
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
# `mock` needs no credentials and simulates realistic pending lifecycles.
# `plaid` talks to the real API.
PROVIDER=mock

# sandbox | production   (Plaid retired the old `development` environment)
PLAID_ENV=sandbox

DATABASE_PATH=./data/finance.db
LOG_LEVEL=info
PORT=4000

# Public HTTPS base URL for this server. Plaid delivers webhooks here.
# During local development use a tunnel (cloudflared / ngrok / tailscale funnel).
# Leave blank to run in poll-only mode.
PUBLIC_BASE_URL=

# --- Plaid credentials ----------------------------------------------------
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# Comma-separated. `transactions` is the only one these two features need.
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_LINK_CLIENT_NAME=Finance Tracker

# --- Polling --------------------------------------------------------------
# How often to run a sync pass, in seconds. Webhooks give near-real-time
# updates; polling is the safety net that also catches pending churn on
# institutions whose webhooks are unreliable.
POLL_INTERVAL_SECONDS=300

# Ask Plaid to pull fresh data from the bank before syncing. This is what
# actually catches tips and hold releases quickly, because without it Plaid
# only refreshes an Item a few times a day on its own schedule.
# NOTE: /transactions/refresh is a paid, rate-limited add-on on most plans.
# Leave false unless your plan includes it.
ENABLE_TRANSACTIONS_REFRESH=false
REFRESH_MIN_INTERVAL_SECONDS=900

# How long a pending transaction can sit unmatched after disappearing before
# we declare it vanished (never posted). Card auth holds typically clear
# within a few days.
PENDING_LIMBO_GRACE_HOURS=72

# --- Notifications --------------------------------------------------------
# Comma-separated list of channels: console, ntfy, pushover, webpush
NOTIFY_CHANNELS=console

# ntfy.sh — zero setup, free, works on iOS + Android. Pick an unguessable
# topic name; anyone who knows the topic can read it.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Pushover — one-time purchase, very reliable delivery on iOS.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Web Push (VAPID) — works in browsers and installed iOS PWAs (iOS 16.4+).
# Generate a keypair with: npm run cli -- vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Security -------------------------------------------------------------
# Bearer token guarding the read API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Verify the JWT signature Plaid puts in the Plaid-Verification header.
# Keep this on in production.
VERIFY_PLAID_WEBHOOKS=true
